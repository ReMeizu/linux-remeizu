// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;
#include "mt6797.dtsi"

/ {
	model = "Meizu MX6";
	compatible = "meizu,mx6", "mediatek,mt6797";
	chassis-type = "handset";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	/* LK must provide the actual DRAM and reserved-memory layout. */

	/*
	 * VBUS for the USB Type-C port. The stock board drives the port
	 * through the SoC USB_DRVVBUS pin function (GPIO94 in the vendor DTS
	 * pinctrl states "drvvbus_low"/"drvvbus_high"), not through a GPIO
	 * owned by Linux, so the 5 V rail is modelled as a fixed supply that
	 * the xHCI driver can request but not switch.
	 */
	vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_mx6_pins>;
	status = "okay";
};

&pio {
	uart0_mx6_pins: uart0-mx6-pins {
		pins-bus {
			pinmux = <MT6797_GPIO97__FUNC_URXD0>,
				 <MT6797_GPIO98__FUNC_UTXD0>;
		};
	};

	emmc_mx6_pins: emmc-mx6-pins {
		pins-bus {
			pinmux = <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
				 <MT6797_GPIO116__FUNC_MSDC0_DAT2>,
				 <MT6797_GPIO117__FUNC_MSDC0_DAT3>,
				 <MT6797_GPIO118__FUNC_MSDC0_DAT4>,
				 <MT6797_GPIO119__FUNC_MSDC0_DAT5>,
				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>,
				 <MT6797_GPIO122__FUNC_MSDC0_CMD>,
				 <MT6797_GPIO123__FUNC_MSDC0_CLK>,
				 <MT6797_GPIO124__FUNC_MSDC0_DSL>,
				 <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
		};
	};
};

&pwrap {
	status = "okay";

	pmic: mt6351 {
		compatible = "mediatek,mt6351";
		interrupt-parent = <&pio>;
		interrupts = <262 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#address-cells = <0>;
		#interrupt-cells = <2>;

		regulators {
			compatible = "mediatek,mt6351-regulator";

			mt6351_vemc: ldo-vemc {
				regulator-name = "vemc";
				regulator-always-on;
			};

			/* Fixed 3.3 V USB transceiver rail (RG_VUSB33_EN only). */
			mt6351_vusb33: ldo-vusb33 {
				regulator-name = "vusb33";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};
		};
	};
};

&mmc0 {
	vmmc-supply = <&mt6351_vemc>;
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&emmc_mx6_pins>;
	pinctrl-1 = <&emmc_mx6_pins>;

	/*
	 * eMMC/PMIC only for now. Display stays disabled: the 6.18 DRM
	 * driver has neither an MT6797 DSI match nor support for the
	 * MT6797 three-OVL cascade. USB is wired up separately below.
	 */
	status = "okay";
};

&usb3phy {
	status = "okay";
};

/*
 * The stock MX6 wires the port as OTG (ID on GPIO181 via the IDDIG pin
 * function, VBUS drive on GPIO94 via USB_DRVVBUS), but mainline has no
 * MT6797 ID/role driver and no FUSB340 Type-C mux driver, so all that can
 * be described is the DRD controller itself. Note that mtu3 derives the
 * runtime role from its Kconfig choice, not from dr_mode: with the default
 * USB_MTU3_DUAL_ROLE both host and gadget are built and the driver forces
 * HOST mode, which is why the xHCI child is enabled below.
 */
&ssusb {
	vusb33-supply = <&mt6351_vusb33>;
	vbus-supply = <&vbus>;
	dr_mode = "otg";
	status = "okay";
};

&usb_host {
	vusb33-supply = <&mt6351_vusb33>;
	vbus-supply = <&vbus>;
	status = "okay";
};
