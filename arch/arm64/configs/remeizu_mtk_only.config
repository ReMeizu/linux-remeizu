# CONFIG_DRM_IMX is not set
# CONFIG_DRM_MESON is not set
# CONFIG_DRM_TIDSS is not set
# CONFIG_INFINIBAND is not set
# CONFIG_ATA is not set
# CONFIG_SCSI_HISILICON is not set
# CONFIG_NET_VENDOR_BROADCOM is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_QUALCOMM is not set
# CONFIG_NET_VENDOR_REALTEK is not set
# CONFIG_NET_VENDOR_STMICRO is not set
# CONFIG_NET_VENDOR_HISILICON is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CIFS is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_SND_SOC_QCOM is not set
# CONFIG_SND_SOC_SOF_TOPLEVEL is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DRM_PANFROST=y
CONFIG_MTK_CONNSYS=y

# Further trim non-Meizu MediaTek SoCs, EFI, MTD, SCSI, Virtio, and optimize size
# so Image.gz + appended DTB + recovery ramdisk fits in 16 MiB boot/recovery partitions.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_EFI is not set
