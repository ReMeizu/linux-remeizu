# Ensure Android 15 eBPF + built-in CONNSYS + Panfrost
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MTK_CONNSYS=y
CONFIG_DRM_PANFROST=y
