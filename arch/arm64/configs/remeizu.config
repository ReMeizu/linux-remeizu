# Help: Build the common MediaTek and Qualcomm phone driver set
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_MT6735=y
CONFIG_PINCTRL_MT6755=y
CONFIG_PINCTRL_MT6797=y
CONFIG_PINCTRL_MSM8953=y
CONFIG_COMMON_CLK_MT6735=y
CONFIG_COMMON_CLK_MT6797=y
CONFIG_COMMON_CLK_MT6735_MMSYS=y
CONFIG_COMMON_CLK_MT6735_MFGCFG=y
CONFIG_COMMON_CLK_MT6755=y
CONFIG_COMMON_CLK_MT6755_AUDIO=y
CONFIG_COMMON_CLK_MT6755_MMSYS=y
CONFIG_COMMON_CLK_MT6797_MMSYS=y
CONFIG_COMMON_CLK_MT6797_MFGCFG=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6311=y
CONFIG_REGULATOR_MT6328=y
CONFIG_REGULATOR_MT6351=y
CONFIG_REGULATOR_MT6353=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_KEYBOARD_MT6779=y
CONFIG_INPUT_REGULATOR_HAPTIC=y
CONFIG_IIO=y
CONFIG_INV_MPU6050_I2C=y
# MX6 (M95): ST LSM6DS3 IMU + Avago APDS9922 light/proximity
CONFIG_IIO_ST_LSM6DSX=y
CONFIG_IIO_ST_LSM6DSX_I2C=y
CONFIG_APDS9922=y
# M3 Note sensors (ltr501 covers LTR-579; txc covers PA12200001)
CONFIG_LTR501=y
CONFIG_PA12203001=y
CONFIG_STK3310=y
CONFIG_MTK_MMSYS=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANFROST=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DRM_PANEL_FITIPOWER_FT8716=y
CONFIG_DRM_PANEL_ILITEK_ILI9881C=y
CONFIG_DRM_PANEL_ILITEK_ILI9885=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_DRM=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_PWM=y
CONFIG_PWM_MTK_DISP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_REGULATOR_TPS65132=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y
# FT5x46/FT5x26/FT8716 TDDI panels: M3 Note, U10/M6/M6T/M3s, MX6
CONFIG_TOUCHSCREEN_FOCALTECH_TDDI=y
# MTK IR: receiver (all) + MT6797 transmitter (MX6)
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_MTK=y
CONFIG_IR_MTK_IRTX=y
# SPI0: Goodix fingerprint sensor on all boards (vendor HAL over spidev)
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_SPI_SPIDEV=y
CONFIG_MTK_CPUX_SECURE_TIMER=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT6328=y
CONFIG_SND_SOC_MT6351=y
CONFIG_SND_SOC_MTK_ACCDET=y
CONFIG_SND_SOC_MT6735=y
CONFIG_SND_SOC_MT6735_MT6328=y
CONFIG_SND_SOC_MT6755=y
CONFIG_SND_SOC_MT6755_MT6351=y
CONFIG_SND_SOC_MT6755_MT6353=y
CONFIG_SND_SOC_MT6797=y
CONFIG_SND_SOC_MT6797_MT6351=y
CONFIG_SND_SOC_MT6797_MX6=y
CONFIG_SND_SOC_TFA989X=y
CONFIG_EINT_MTK=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ=y
CONFIG_SOUND=y
# MediaTek CONSYS combo connectivity (Wi-Fi / Bluetooth / GPS)
CONFIG_CFG80211=y
CONFIG_MTK_CONNSYS=y

# MediaTek MD1 cellular modem (ECCCI / CLDMA / CCMNI)
CONFIG_MTK_ECCCI=y
