# pmOS kconfigcheck [category:default] base requirements (real rootfs).
# BISECT (early-boot crash): crypto/dm/md cluster REMOVED — it was only for
# the FDE (--fde) path; we install --no-fde so it is not needed. Removing it
# is both a legit simplification and the first bisect step for the pre-
# ramoops_probe crash introduced by commit bde20b4ea (real-rootfs configs).
CONFIG_CGROUPS=y
CONFIG_INPUT_EVDEV=y
CONFIG_TMPFS_POSIX_ACL=y
# net for USB gadget networking (ssh over usb)
CONFIG_NET=y
CONFIG_INET=y
# CRITICAL socket families — without these, userspace cannot come up:
#   UNIX (AF_UNIX): udev control socket, OpenRC, dbus, sshd, logind. Its
#     absence (r16/r17) made udevd fail ("error initializing udev control
#     socket") -> /dev not populated (/dev/input missing) -> cascade failure.
#   PACKET (AF_PACKET): raw sockets used by unudhcpd/DHCP. Its absence made
#     unudhcpd fail ("Unable to bind to interface: Protocol not available")
#     -> usb0 never got an IP -> no ssh-over-usb, ever. (FACT: r17 ramoops.)
#   NETDEVICES: network device layer for the usb0 gadget netdev.
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
# --- Tier 1: fix the pmOS OpenRC service failures seen in r18 /var/log/boot.log ---
# zram swap ("postmarketos-zram-swap failed to start" = no zram). zram needs an
# allocator (zsmalloc) + a crypto compressor.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
# nftables firewall ("nftables failed: kernel lacks nftables support")
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
# sysctl keys pmOS sets that were "unknown key" in r18 (tcp_syncookies, bpf)
CONFIG_BPF_SYSCALL=y
CONFIG_SYN_COOKIES=y
# TUN/TAP (VPN / containers)
CONFIG_TUN=y
# NB: do NOT enable the legacy g_ether (CONFIG_USB_ETH) — built-in, it
# auto-binds the mtu3 UDC at boot ("g_ether ready" before userspace) and then
# pmOS cannot claim the UDC for its configfs RNDIS/NCM gadget. USB networking
# is driven by pmOS via USB_CONFIGFS_{NCM,RNDIS} (enabled above) instead.
# --- "good logs" harness ---
# PSTORE_CONSOLE/PMSG/RAM already on; the DT ramoops node stays at the M1
# known-good extent (0xe0000, no ECC) — see mt6755-meizu-m681.dts.
#
# NOTE: DRM/SIMPLEDRM/FBDEV/FB/FRAMEBUFFER_CONSOLE were REMOVED here. The first
# real pmOS boot with them enabled died before pstore console init (ramoops
# stayed byte-zero after a warm reboot -> kernel wrote nothing = crash before
# ramoops_probe). DRM/FB core init is subsys_initcall, which runs before
# ramoops probes, so a fault there matches the symptom. They gave no display
# anyway without the LK fb_base. Re-add ONLY after a clean boot is confirmed,
# one at a time, checking ramoops each time.
